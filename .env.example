# ── 앱 ──────────────────────────────────────────────
# 세션 쿠키 서명 키. 운영에서는 반드시 교체할 것.
AUTH_SECRET=change-me-please-32-chars-minimum-secret

# 데모 기준일. 시드 데이터가 2026-07 기준이라 고정해 두면
# "이번주 방문 일정" · D-day · KPI 가 의미 있게 보인다.
# 실제 오늘 날짜를 쓰려면 빈 값으로.
NEXT_PUBLIC_DEMO_TODAY=2026.07.26

# 앱이 노출될 호스트 포트
APP_PORT=3000

# ── 지도 ────────────────────────────────────────────
# 비워 두면 OpenStreetMap(Leaflet) 을 쓴다. 네이버 지도를 쓰려면
# NAVER Cloud Platform > Maps 에서 발급받은 값을 채운다.
#   https://console.ncloud.com  →  Services > Application Services > Maps
#   Web 서비스 URL 에 http://localhost:3000 을 등록해야 로드된다.
#
# 브라우저에서 지도를 그릴 때 쓰는 공개 키
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# SDK 쿼리 파라미터 이름 — 신규 계정은 ncpKeyId, 구 계정은 ncpClientId
NEXT_PUBLIC_NAVER_MAP_KEY_PARAM=ncpKeyId
# 서버에서 주소 검색·역지오코딩에 쓰는 키 (노출 금지)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ── MySQL ───────────────────────────────────────────
MYSQL_DATABASE=inspection
MYSQL_USER=inspection
MYSQL_PASSWORD=inspection
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# 시드가 만드는 데모 계정의 비밀번호
SEED_PASSWORD=1234

# compose 안에서는 host 가 db, 로컬 개발에서는 127.0.0.1
DATABASE_URL=mysql://inspection:inspection@127.0.0.1:3306/inspection
