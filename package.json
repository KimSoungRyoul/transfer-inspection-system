{
  "name": "transfer-inspection-system",
  "version": "1.0.0",
  "private": true,
  "description": "준공 이관검사 시스템 — Next.js + MySQL",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "build:next": "next build",
    "compose:up": "docker compose up -d --build || podman compose up -d --build",
    "compose:down": "docker compose down || podman compose down",
    "db:dump": "sh tools/dump-initdb.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.3.1",
    "bcryptjs": "3.0.2",
    "jose": "6.0.8",
    "leaflet": "1.9.4",
    "motion": "^13.1.1",
    "next": "15.1.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.16",
    "@types/node": "22.13.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "prisma": "6.3.1",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
